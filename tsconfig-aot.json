{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "declaration": true,
        "lib": ["ES2022", "dom"],
        "noImplicitAny": true,
        "types": ["requirejs"]
    },
    "exclude": [
        "node_modules"
    ],
    "files": [
        "src/app/app.module.ts",
        "src/app/main.ts"
    ],
    "angularCompilerOptions": {
        "skipMetadataEmit": true
    }
}